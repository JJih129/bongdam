# Netlify 캐시 규칙. 이 브랜치(main)는 «완성본만» 올리는 배포 전용이라
# netlify.toml 의 빌드 설정 대신 _headers 를 쓴다(빌드 단계가 없다).
#
# 에셋 파일명에는 내용 해시가 붙는다(예: 62ec_npc_front_band_guitar.png).
# 내용이 바뀌면 이름이 바뀌므로 오래 캐시해도 낡은 파일이 나올 수 없다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 반대로 아래 셋은 이름이 고정이라 캐시되면 배포해도 옛 화면이 계속 나온다.
# (서비스워커가 낡은 채로 남아 새 배포가 안 보이는 문제를 겪은 적이 있다.)
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
