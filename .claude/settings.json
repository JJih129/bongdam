{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bundle.js",
            "timeout": 90,
            "statusMessage": "src -> bundle sync"
          }
        ]
      }
    ]
  }
}
